        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"temperature\": 0.3,\n  \"max_tokens\": 800,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a strict B2B sales intelligence analyst. Return ONLY valid JSON. Score 0-39 for B2C companies like McDonalds, Walmart, Netflix. Score 70-100 only for B2B SaaS with 10-200 employees. Return: {\\\"icp_score\\\": 0, \\\"company_summary\\\": \\\"text\\\", \\\"top_3_pain_points\\\": [\\\"p1\\\",\\\"p2\\\",\\\"p3\\\"], \\\"personalization_hook\\\": \\\"text\\\", \\\"best_angle\\\": \\\"text\\\", \\\"timing_trigger\\\": \\\"text\\\", \\\"confidence\\\": \\\"high|medium|low\\\"}. IMPORTANT: Return raw JSON only. No markdown. No backticks. No json. Just the JSON object.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"={{ 'Company: ' + ($json.company_name || 'unknown') + ' Website: ' + JSON.stringify(($json.website_content || '').substring(0, 1500)).slice(1, -1) + ' Decision maker: ' + ($json.decision_maker_name || 'unknown') }}\"\n    }\n  ]\n}",
        "options": {}
