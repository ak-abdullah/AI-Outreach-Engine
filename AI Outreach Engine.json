    {
      "parameters": {
        "jsCode": "const content = $input.first().json.choices[0].message.content;\n\n// Only escape newlines inside string values, not structural ones\nlet result = '';\nlet inString = false;\nlet escape = false;\n\nfor (let i = 0; i < content.length; i++) {\n  const char = content[i];\n  \n  if (escape) {\n    result += char;\n    escape = false;\n    continue;\n  }\n  if (char === '\\\\' && inString) {\n    result += char;\n    escape = true;\n    continue;\n  }\n  if (char === '\"') {\n    inString = !inString;\n    result += char;\n    continue;\n  }\n  if (inString && char === '\\n') {\n    result += '\\\\n';\n    continue;\n  }\n  if (inString && char === '\\r') {\n    result += '\\\\r';\n    continue;\n  }\n  result += char;\n}\n\nconst parsed = JSON.parse(result);\nreturn [{ json: parsed }];"
      },
